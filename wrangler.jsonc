{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "birkez",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",

  // Sayfalar, CSS ve tarayıcıdaki şifreleme kodu
  "assets": { "directory": "./public", "binding": "ASSETS" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "birkez",
      // Yayın adımında `wrangler d1 create birkez` çıktısındaki gerçek id ile değişecek
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Kötüye kullanıma karşı IP başına sınırlar (Cloudflare Rate Limiting, ücretsiz)
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "READ_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],

  // Saatte bir süresi dolmuş notları temizle
  "triggers": { "crons": ["0 * * * *"] }
}
